@startuml
!pragma layout smetana
!include <C4/C4_Container>
LAYOUT_TOP_DOWN()
title C4 — контейнеры системы веб-аналитики рынка
Person(user, "Пользователь", "Анализирует рынок и самостоятельно принимает решения")
System_Boundary(system, "Веб-аналитика XAUUSD / EURUSD / GBPUSD") {
Container(spa, "Веб-интерфейс", "Angular · TypeScript · Taiga UI · Signals / RxJS", "График, рисунки, рабочие области, replay, аналитические разделы. Личный вклад Васильева Артёма. Библиотека графиков не выбрана.")
Container(api, "Единый серверный API", "Технология не выбрана", "Командная зона: авторизация по владельцу; аналитика, SMC, ML, сезонный скринер, бэктест; исторические версии и snapshot cutoff.")
ContainerDb(store, "Серверное хранилище", "Технология не выбрана", "Рабочие области, раскладки, рисунки; временные ряды и версии аналитики")
}
System_Ext(providers, "Внешние источники данных", "Рыночные котировки, календарь, новости, социальные данные. Конкретные поставщики не определены.")
Rel(user, spa, "Работает через браузер", "HTTPS")
Rel(spa, api, "Запрашивает снимки / сохраняет; получает поток", "HTTPS REST + WSS push")
Rel(api, store, "Читает и сохраняет; проверяет владельца", "Серверный протокол не выбран")
Rel(api, providers, "Получает данные", "Серверные интеграции; протоколы уточняются")
note right of api
Учётные данные источников / брокера
доступны только серверу, не SPA.
Сервер фиксирует cutoff для replay;
SPA отклоняет неверный контекст
и данные из будущего.
end note
@enduml
